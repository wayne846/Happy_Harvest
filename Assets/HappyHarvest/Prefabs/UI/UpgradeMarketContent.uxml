<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Content" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: auto; flex-direction: row; margin-top: 5px; margin-bottom: 5px;">
        <ui:VisualElement name="ItemEntry" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); width: 70%; flex-direction: row;">
            <ui:Label tabindex="-1" text="Item Name" display-tooltip-when-elided="true" name="ItemName" style="flex-grow: 1; -unity-text-align: middle-center; font-size: 26px; background-color: rgb(0, 88, 156); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px;" />
        </ui:VisualElement>
        <ui:Button text="Buy For " display-tooltip-when-elided="true" name="ActionButton" style="flex-grow: 1; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; -unity-text-align: upper-center; align-items: stretch; align-self: auto; padding-bottom: 26px;" />
    </ui:VisualElement>
</ui:UXML>
